# Leave VITE_API_BASE_URL unset in development: requests go to the Vite dev
# server origin and are proxied to the Laravel API (see server.proxy in
# vite.config.js), which keeps the session cookie same-origin.
# Set this only when the Laravel API is served from a different origin without
# a proxy — CORS and SANCTUM_STATEFUL_DOMAINS must allow this frontend then.
# VITE_API_BASE_URL=http://localhost:8000
